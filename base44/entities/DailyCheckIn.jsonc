{
  "name": "DailyCheckIn",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of check-in"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "spine_score": {
      "type": "number",
      "description": "Spine score at time of check-in"
    },
    "exerciseIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of exercises in this day's plan (used for 3-day non-repeat window)"
    }
  },
  "required": [
    "date",
    "completed"
  ]
}